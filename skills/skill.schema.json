{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace AI Assistant Skill",
  "type": "object",
  "required": ["id", "name", "description", "triggers", "capabilities"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "triggers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "returns"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "returns": { "type": "string" }
        }
      }
    }
  }
}

